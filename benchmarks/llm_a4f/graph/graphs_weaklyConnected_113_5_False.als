sig MyNode { adj : set MyNode } pred undirected { adj = ~adj } pred oriented { no adj & ~adj } pred acyclic { all a:MyNode | a not in a.^adj } pred complete { all n:MyNode | MyNode in n.adj } pred noLoops { no (iden & adj) } pred weaklyConnected { all x : MyNode | MyNode in x.adj + adj.x + x } pred stronglyConnected { all n:MyNode | MyNode in n.*adj } pred transitive { adj.adj in adj } pred undirectedOK { adj = ~adj } assert undirectedRepaired { undirected[] iff undirectedOK[] } pred orientedOK { no adj & ~adj } assert orientedRepaired { oriented[] iff orientedOK[] } pred acyclicOK { all a:MyNode | a not in a.^adj } assert acyclicRepaired { acyclic[] iff acyclicOK[] } pred completeOK { all n:MyNode | MyNode in n.adj } assert completeRepaired { complete[] iff completeOK[] } pred noLoopsOK { no (iden & adj) } assert noLoopsRepaired { noLoops[] iff noLoopsOK[] } pred weaklyConnectedOK { all n:MyNode | MyNode in n.*(adj+~adj) } assert weaklyConnectedRepaired { weaklyConnected[] iff weaklyConnectedOK[] } pred stronglyConnectedOK { all n:MyNode | MyNode in n.*adj } assert stronglyConnectedRepaired { stronglyConnected[] iff stronglyConnectedOK[] } pred transitiveOK { adj.adj in adj } assert transitiveRepaired { transitive[] iff transitiveOK[] } 